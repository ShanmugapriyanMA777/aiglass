# ==============================================================================
# VISIONASSIST AI GLASSES - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Multimodal Vision & Voice LLM Providers
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER=groq

# Google Gemini API Key (Direct multimodal vision and reasoning)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter API Key (Alternative multimodal vision fallback)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. Wolfram|Alpha Computational Intelligence Engine
# Used for mathematical, physical, calculus, and scientific calculations
# Get from: https://developer.wolframalpha.com/
WOLFRAM_APP_ID=your_wolfram_app_id_here

# 3. Google Maps Voice Navigation
# Basic voice deep-link navigation requires NO API keys or Cloud billing.
# Optional Google Maps API key only needed for advanced server-side places search / elevation.
DEFAULT_TRAVEL_MODE=walking
ENABLE_NAVIGATION=true
VITE_DEFAULT_TRAVEL_MODE=walking
VITE_ENABLE_NAVIGATION=true

# 4. Supabase Cloud Database & Realtime Guardian Telemetry
# (Safe public anon key for frontend; service role key only in edge functions)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

